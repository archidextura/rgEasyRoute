# 이 파일을 복사해 이름을 .env 로 바꾸고, = 뒤에 키를 붙여 넣으세요. 따옴표는 없어도 됩니다.
# .env 파일은 다른 사람과 공유하거나 깃허브에 올리지 마세요.

# ODsay LAB > 애플리케이션 > Server 키 (등록한 공인 IP에서만 동작)
ODSAY_KEY=

# SK open API (TMAP) 앱 키: 지도 표시 + 보행자 경로 + 장소 검색
TMAP_APP_KEY=

# (선택) 카카오 디벨로퍼스 > 앱 키 > REST API 키. 넣으면 장소 검색만 카카오로 합니다 (한국 장소명 검색이 가장 정확).
KAKAO_REST_KEY=
